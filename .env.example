# CodeLens environment template
# Copy to .env for local development and fill in values as needed.

# Backend
CODELENS_ENV=development
CODELENS_HOST=127.0.0.1
CODELENS_PORT=8000
CODELENS_TEMP_ROOT=
CORS_ORIGINS=http://localhost:5173

# OpenAI (required only for live indexing and LLM requests)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMENSIONS=

# Runtime limits
CODELENS_MAX_REPOSITORY_BYTES=
CODELENS_MAX_FILE_BYTES=
CODELENS_TOP_K=

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# CodeLens environment template
# Copy to .env for local development and fill in values as needed.

# Backend
CODELENS_ENV=development
CODELENS_HOST=127.0.0.1
CODELENS_PORT=8000
CODELENS_TEMP_ROOT=
CORS_ORIGINS=http://localhost:5173

# Providers (fake is credential-free; Gemini is used for live embeddings)
CODELENS_EMBEDDING_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=8
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BACKOFF=0.25

# Future live LLM configuration
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=

# Runtime limits
CODELENS_MAX_REPOSITORY_BYTES=
CODELENS_MAX_FILE_BYTES=
CODELENS_TOP_K=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
